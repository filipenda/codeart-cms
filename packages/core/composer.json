{
    "name": "codeart/core",
    "description": "CodeArt CMS core: foundation, design tokens and shared contracts.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Codeart\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codeart\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codeart\\Core\\CoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "pint": "pint --test",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "check": [
            "@pint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
