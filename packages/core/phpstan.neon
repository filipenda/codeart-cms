includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Start at 6, raise gradually towards 9 (see docs/DECISIONS.md).
    level: 6
    paths:
        - src
        - config
    ignoreErrors:
        # Traits are used by models in other packages (and in tests), not inside core's src.
        -
            identifier: trait.unused
            path: src/Translations/Translatable.php
        # The app's User model gets its columns (name, email, is_active, ...) and the AdminUser/HasRoles methods
        # from the app, not from core: core talks to it through the Eloquent model and these documented attributes.
        -
            identifier: property.notFound
            paths:
                - src/Auth
                - src/ActivityLog
                - src/Console
        -
            identifier: method.notFound
            paths:
                - src/Auth
        -
            identifier: trait.unused
            path: src/Auth/Concerns/AdminUser.php
        # Views of this package are in the `codeart::` namespace, which the analyser cannot resolve to files.
        -
            identifier: argument.type
            message: '#\$view of function view expects view-string#'
            paths:
                - src/Auth
                - src/Admin
                - src/Tables
                - src/Confirmation
                - src/Users
