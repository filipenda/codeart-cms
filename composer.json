{
    "name": "codeart/cms-monorepo",
    "description": "CodeArt CMS monorepo: root tooling only. Dependencies live in each package / app.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "scripts": {
        "setup": [
            "@composer --working-dir=packages/core install --no-interaction",
            "@composer --working-dir=apps/starter install --no-interaction"
        ],
        "check:colors": "@php tools/check-colors.php",
        "preview:install": "@php tools/preview-install.php",
        "preview:install:clean": "@php tools/preview-install.php --clean",
        "check:core": "@composer --working-dir=packages/core check",
        "check:starter": "@composer --working-dir=apps/starter check",
        "check": [
            "@check:colors",
            "@check:core",
            "@check:starter"
        ],
        "check:fast": [
            "@check:colors",
            "@composer --working-dir=packages/core pint",
            "@composer --working-dir=apps/starter pint",
            "@composer --working-dir=packages/core stan",
            "@composer --working-dir=apps/starter stan",
            "@php tools/affected-tests.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    }
}
